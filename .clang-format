# CS258 formatting rules
#
# clang-format is OPTIONAL for this course.  If you have it installed, it will
# format your code to match the style used throughout these assignments, and
# your editor can run it every time you save.  If you do not have it, nothing
# here affects you - your code compiles exactly the same either way.
#
#   Install:  sudo apt install clang-format      (Ubuntu / WSL / Codespaces)
#             pip install clang-format           (no admin rights needed)
#
#   Use:      clang-format -i yourfile.cpp       (-i means edit the file)
#
# VS Code picks this file up automatically once the C/C++ extension is
# installed.  Turn on "Format on Save" and you never think about it again.

BasedOnStyle: LLVM

# Four spaces, never tabs.
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4

# Braces on their own line, which is the style the textbook code uses.
BreakBeforeBraces: Allman

# Keep the & and * attached to the TYPE, not the variable, so we write
# const ItemType& item  and  Node<ItemType>* next
PointerAlignment: Left
ReferenceAlignment: Left

# template<class ItemType> with no space, as the textbook writes it.
SpaceAfterTemplateKeyword: false

# Keep the template parameter list on its own line above the class or function.
# Without this, a short declaration that happens to fit inside 80 columns gets
# joined onto one line, which is not how the textbook code is written.
AlwaysBreakTemplateDeclarations: Yes

# Wrap at 80 columns - the width used by both the LLVM and Google C++ style
# guides, and what fits a standard terminal.  Long lines become hanging indents
# rather than running off the side of the screen.
ColumnLimit: 80

# Leave #include order alone - some of these headers depend on being included
# in a particular order.
SortIncludes: false

# An empty function body may stay on one line; anything with real code in it
# gets expanded.
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

# The textbook writes  }  // end foo  with two spaces before the comment.
# Keep that, rather than churning every one of them to a single space.
SpacesBeforeTrailingComments: 2

# Wrap comments to the column limit as well.  Without this, code would be
# wrapped at 80 while comments ran off the screen - and documentation is worth
# real credit in this course, so it should be held to the same standard.
ReflowComments: true

KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 2
